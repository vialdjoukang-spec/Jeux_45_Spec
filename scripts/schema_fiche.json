{
  "title": "Fiche de raisonnement d'une entité (source unique de vérité du jeu)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "enUneLigne",
    "frequence",
    "urgenceVitale",
    "premiersGestes",
    "drapeauxRouges",
    "presentation",
    "discriminants",
    "examens",
    "priseEnCharge",
    "chiffresCles",
    "ladder",
    "pieges",
    "notionsCouvertes",
    "sources",
    "glossaire"
  ],
  "properties": {
    "enUneLigne": {
      "type": "string",
      "minLength": 40,
      "description": "Une phrase verbale qui dit ce qu'est l'entité et pourquoi elle compte."
    },
    "frequence": {
      "enum": [
        "tres_frequente",
        "frequente",
        "peu_frequente",
        "rare"
      ]
    },
    "urgenceVitale": {
      "type": "boolean"
    },
    "premiersGestes": {
      "type": "array",
      "minItems": 3,
      "maxItems": 8,
      "description": "Ce qu'il faut faire, dans l'ordre exact, devant cette entité. Le geste 1 est celui à faire EN PREMIER.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "ordre",
          "action",
          "pourquoi"
        ],
        "properties": {
          "ordre": {
            "type": "integer",
            "minimum": 1
          },
          "action": {
            "type": "string",
            "minLength": 10
          },
          "pourquoi": {
            "type": "string",
            "minLength": 30
          }
        }
      }
    },
    "drapeauxRouges": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "signe",
          "signification",
          "action"
        ],
        "properties": {
          "signe": {
            "type": "string"
          },
          "signification": {
            "type": "string",
            "minLength": 20
          },
          "action": {
            "type": "string",
            "minLength": 10
          }
        }
      }
    },
    "presentation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "typique",
        "atypique"
      ],
      "properties": {
        "typique": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "element",
              "mecanisme"
            ],
            "properties": {
              "element": {
                "type": "string"
              },
              "mecanisme": {
                "type": "string",
                "minLength": 20
              }
            }
          }
        },
        "atypique": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "element",
              "terrain"
            ],
            "properties": {
              "element": {
                "type": "string"
              },
              "terrain": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "discriminants": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "rival",
          "elementQuiTranche"
        ],
        "properties": {
          "rival": {
            "type": "string"
          },
          "elementQuiTranche": {
            "type": "string",
            "minLength": 20
          }
        }
      }
    },
    "examens": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "ordre",
          "examen",
          "quand",
          "attendu",
          "pourquoi",
          "visee"
        ],
        "properties": {
          "ordre": {
            "type": "integer"
          },
          "examen": {
            "type": "string"
          },
          "quand": {
            "type": "string"
          },
          "attendu": {
            "type": "string"
          },
          "pourquoi": {
            "type": "string",
            "minLength": 20
          },
          "visee": {
            "type": "string",
            "enum": [
              "diagnostique_1re_intention",
              "diagnostique_gold_standard",
              "retentissement",
              "etiologique",
              "complications",
              "therapeutique",
              "sortie"
            ]
          }
        }
      }
    },
    "priseEnCharge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "but",
        "moyens",
        "conduite",
        "pronostic",
        "surveillance",
        "prevention"
      ],
      "properties": {
        "but": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "items": {
            "type": "string",
            "description": "Phrase verbale : ce que la prise en charge cherche à obtenir."
          }
        },
        "moyens": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "accueil",
            "pharmacologique",
            "nonPharmacologique",
            "transversal"
          ],
          "properties": {
            "accueil": {
              "type": "array",
              "minItems": 2,
              "maxItems": 5,
              "items": {
                "type": "string",
                "description": "Mesure générale à l'accueil, phrase verbale."
              }
            },
            "pharmacologique": {
              "type": "array",
              "minItems": 0,
              "maxItems": 6,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "molecule",
                  "posologie",
                  "pourquoi",
                  "source"
                ],
                "properties": {
                  "molecule": {
                    "type": "string",
                    "description": "DCI, et classe entre parenthèses."
                  },
                  "posologie": {
                    "type": "string",
                    "description": "Dose, voie, rythme, durée, adaptation rénale/hépatique/âge si utile ; selon l'AIPS suisse."
                  },
                  "pourquoi": {
                    "type": "string",
                    "description": "Une phrase de 20 mots au plus.",
                    "minLength": 20
                  },
                  "source": {
                    "type": "string",
                    "description": "[Société, année] ou « AIPS Swissmedic »"
                  }
                }
              }
            },
            "nonPharmacologique": {
              "type": "array",
              "minItems": 1,
              "maxItems": 6,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "categorie",
                  "mesure",
                  "pourquoi"
                ],
                "properties": {
                  "categorie": {
                    "type": "string",
                    "enum": [
                      "psychothérapie",
                      "éducation thérapeutique",
                      "geste ou chirurgie",
                      "rééducation",
                      "nutrition",
                      "soins infirmiers",
                      "social et assurances",
                      "hygiène de vie",
                      "autre"
                    ]
                  },
                  "mesure": {
                    "type": "string",
                    "description": "Phrase verbale."
                  },
                  "pourquoi": {
                    "type": "string",
                    "description": "Une phrase de 20 mots au plus."
                  }
                }
              }
            },
            "transversal": {
              "type": "array",
              "minItems": 1,
              "maxItems": 4,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "discipline",
                  "apport"
                ],
                "properties": {
                  "discipline": {
                    "type": "string",
                    "description": "Lettre et nom de la discipline transversale A→S (ex. « A Assurances sociales », « F Droit médical suisse », « M Médecine palliative »)."
                  },
                  "apport": {
                    "type": "string",
                    "description": "Phrase verbale : ce que cette discipline apporte à ce patient."
                  }
                }
              }
            }
          }
        },
        "conduite": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "urgence",
            "horsUrgence"
          ],
          "properties": {
            "urgence": {
              "anyOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "mesuresGenerales",
                    "etapes"
                  ],
                  "properties": {
                    "mesuresGenerales": {
                      "type": "array",
                      "minItems": 2,
                      "maxItems": 5,
                      "items": {
                        "type": "string",
                        "description": "Phrase verbale."
                      }
                    },
                    "etapes": {
                      "type": "array",
                      "minItems": 3,
                      "maxItems": 8,
                      "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "temps",
                          "qui",
                          "fait"
                        ],
                        "properties": {
                          "temps": {
                            "type": "string",
                            "enum": [
                              "d'abord",
                              "en même temps",
                              "ensuite",
                              "puis"
                            ]
                          },
                          "qui": {
                            "type": "string",
                            "description": "Rôle : médecin responsable, infirmier·ère, second médecin, spécialiste, physiothérapeute, assistant·e social·e, patient·e…"
                          },
                          "fait": {
                            "type": "string",
                            "description": "Phrase verbale : ce que cette personne fait, et pourquoi en 15 mots au plus."
                          }
                        }
                      },
                      "description": "Ordre chronologique ; « en même temps » marque le travail concomitant de l'équipe que dirige le médecin."
                    }
                  }
                },
                {
                  "type": "null"
                }
              ],
              "description": "null si la maladie ne comporte pas de situation d'urgence."
            },
            "horsUrgence": {
              "anyOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "mesuresGenerales",
                    "etapes"
                  ],
                  "properties": {
                    "mesuresGenerales": {
                      "type": "array",
                      "minItems": 2,
                      "maxItems": 5,
                      "items": {
                        "type": "string",
                        "description": "Phrase verbale."
                      }
                    },
                    "etapes": {
                      "type": "array",
                      "minItems": 3,
                      "maxItems": 8,
                      "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "temps",
                          "qui",
                          "fait"
                        ],
                        "properties": {
                          "temps": {
                            "type": "string",
                            "enum": [
                              "d'abord",
                              "en même temps",
                              "ensuite",
                              "puis"
                            ]
                          },
                          "qui": {
                            "type": "string",
                            "description": "Rôle : médecin responsable, infirmier·ère, second médecin, spécialiste, physiothérapeute, assistant·e social·e, patient·e…"
                          },
                          "fait": {
                            "type": "string",
                            "description": "Phrase verbale : ce que cette personne fait, et pourquoi en 15 mots au plus."
                          }
                        }
                      },
                      "description": "Ordre chronologique ; « en même temps » marque le travail concomitant de l'équipe que dirige le médecin."
                    }
                  }
                },
                {
                  "type": "null"
                }
              ],
              "description": "null si la maladie n'existe qu'en urgence."
            }
          }
        },
        "pronostic": {
          "type": "string",
          "description": "Une à deux phrases verbales, chiffrées si une source le permet."
        },
        "surveillance": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "suivi",
            "sortie"
          ],
          "properties": {
            "suivi": {
              "type": "array",
              "minItems": 2,
              "maxItems": 6,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "quoi",
                  "quand",
                  "cible"
                ],
                "properties": {
                  "quoi": {
                    "type": "string",
                    "description": "Paramètre clinique, biologique ou d'imagerie."
                  },
                  "quand": {
                    "type": "string",
                    "description": "Rythme ou échéance."
                  },
                  "cible": {
                    "type": "string",
                    "description": "Valeur ou évolution attendue."
                  }
                }
              }
            },
            "sortie": {
              "type": "string",
              "description": "Critères précis de sortie de l'hôpital (ou « prise en charge ambulatoire d'emblée » avec le critère qui l'autorise)."
            }
          }
        },
        "prevention": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "primaire",
            "secondaire",
            "tertiaire"
          ],
          "properties": {
            "primaire": {
              "type": "string",
              "description": "Phrase verbale, ou chaîne vide si sans objet."
            },
            "secondaire": {
              "type": "string"
            },
            "tertiaire": {
              "type": "string"
            }
          }
        }
      }
    },
    "chiffresCles": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "valeur",
          "signification",
          "source"
        ],
        "properties": {
          "valeur": {
            "type": "string"
          },
          "signification": {
            "type": "string",
            "minLength": 15
          },
          "source": {
            "type": "string"
          }
        }
      }
    },
    "ladder": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "zeroD",
        "mechanism",
        "semiology",
        "discriminant",
        "decision",
        "trap",
        "anchor"
      ],
      "properties": {
        "zeroD": {
          "type": "string",
          "minLength": 60
        },
        "mechanism": {
          "type": "string",
          "minLength": 60
        },
        "semiology": {
          "type": "string",
          "minLength": 60
        },
        "discriminant": {
          "type": "string",
          "minLength": 60
        },
        "decision": {
          "type": "string",
          "minLength": 60
        },
        "trap": {
          "type": "string",
          "minLength": 40
        },
        "anchor": {
          "type": "string",
          "minLength": 20
        }
      }
    },
    "pieges": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "erreur",
          "type",
          "correction"
        ],
        "properties": {
          "erreur": {
            "type": "string"
          },
          "type": {
            "enum": [
              "chronologie_inversee",
              "confusion_entite_voisine",
              "confusion_mecanisme",
              "contre_indication_ignoree",
              "examen_inutile",
              "posologie_fausse",
              "seuil_mal_retenu",
              "urgence_sous_estimee"
            ]
          },
          "correction": {
            "type": "string",
            "minLength": 20
          }
        }
      }
    },
    "notionsCouvertes": {
      "type": "array",
      "minItems": 1,
      "description": "Une entrée par rubrique de la Cartographie : le développement complet des notions exigibles.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "rubrique",
          "developpement"
        ],
        "properties": {
          "rubrique": {
            "type": "string"
          },
          "developpement": {
            "type": "string",
            "minLength": 80
          }
        }
      }
    },
    "transversalIds": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^TRANS_[A-S]$"
      }
    },
    "mediaQueries": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "level",
          "ref"
        ],
        "properties": {
          "level": {
            "enum": [
              "AIPS",
              "Compendium",
              "CH",
              "EU",
              "INT"
            ]
          },
          "ref": {
            "type": "string"
          },
          "date": {
            "type": "string"
          }
        }
      }
    },
    "glossaire": {
      "type": "array",
      "minItems": 1,
      "description": "Chaque sigle, score ou terme technique employé dans la fiche (ex. « atypique », « CURB-65 ») avec sa définition en une phrase verbale : l'apprenant ne quitte jamais le jeu.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "terme",
          "definition"
        ],
        "properties": {
          "terme": {
            "type": "string"
          },
          "definition": {
            "type": "string"
          }
        }
      }
    }
  }
}