{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Lot d'items d'une rubrique d'entité (MedSuisse Arena 45)",
  "type": "object",
  "required": ["items"],
  "additionalProperties": false,
  "properties": {
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["format", "pillar", "difficulty", "stem", "prompt", "ladder", "sources", "transversalIds"],
        "properties": {
          "format": {"enum": ["A", "Kprim"]},
          "pillar": {"enum": ["Sciences fondamentales", "Sciences cliniques", "Thérapeutique"]},
          "difficulty": {"type": "integer", "minimum": 1, "maximum": 5},
          "stem": {"type": "string", "minLength": 80},
          "prompt": {"type": "string", "minLength": 10},
          "options": {
            "type": "array", "minItems": 5, "maxItems": 5,
            "items": {
              "type": "object", "additionalProperties": false,
              "required": ["key", "text", "correct", "errorType", "why"],
              "properties": {
                "key": {"enum": ["A", "B", "C", "D", "E"]},
                "text": {"type": "string", "minLength": 3},
                "correct": {"type": "boolean"},
                "errorType": {"enum": [null, "chronologie_inversee", "confusion_entite_voisine", "confusion_mecanisme", "contre_indication_ignoree", "examen_inutile", "posologie_fausse", "seuil_mal_retenu", "urgence_sous_estimee"]},
                "why": {"type": "string", "minLength": 40}
              }
            }
          },
          "statements": {
            "type": "array", "minItems": 4, "maxItems": 4,
            "items": {
              "type": "object", "additionalProperties": false,
              "required": ["text", "true", "why"],
              "properties": {
                "text": {"type": "string", "minLength": 10},
                "true": {"type": "boolean"},
                "why": {"type": "string", "minLength": 40}
              }
            }
          },
          "ladder": {
            "type": "object", "additionalProperties": false,
            "required": ["zeroD", "mechanism", "semiology", "discriminant", "decision", "trap", "anchor"],
            "properties": {
              "zeroD": {"type": "string", "minLength": 60},
              "mechanism": {"type": "string", "minLength": 60},
              "semiology": {"type": "string", "minLength": 60},
              "discriminant": {"type": "string", "minLength": 60},
              "decision": {"type": "string", "minLength": 60},
              "trap": {"type": "string", "minLength": 40},
              "anchor": {"type": "string", "minLength": 20}
            }
          },
          "mediaQuery": {"type": "string", "description": "Recherche Wikimedia Commons suggérée pour une image réelle sous licence libre, ou chaîne vide."},
          "sources": {
            "type": "array", "minItems": 1,
            "items": {
              "type": "object", "additionalProperties": false,
              "required": ["level", "ref"],
              "properties": {
                "level": {"enum": ["AIPS", "Compendium", "CH", "EU", "INT"]},
                "ref": {"type": "string", "minLength": 3},
                "date": {"type": "string"}
              }
            }
          },
          "transversalIds": {"type": "array", "items": {"type": "string", "pattern": "^TRANS_[A-S]$"}}
        }
      }
    }
  }
}
