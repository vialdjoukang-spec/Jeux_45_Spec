ive","correct":true,"why":"Pas d'attente."},{"key":"B","text":"On attend la radiographie","correct":false,"why":"Retard mortel."},{"key":"C","text":"L'absence de déviation exclut le diagnostic","correct":false,"why":"Faux."},{"key":"D","text":"On fait un CT","correct":false,"why":"Retard."},{"key":"E","text":"On donne un bronchodilatateur","correct":false,"why":"Faux."}],"statements":[],"notions":["N10","N13","N08","N09"],"angle":"piège","difficulte":2,"ladder":{"zeroD":"Choc.","mechanism":"Clapet.","semiology":"Pas de déviation.","discriminant":"Signe tardif.","decision":"Décomprimer.","trap":"Radiographie.","anchor":"Pas de déviation ≠ exclusion."},"sources":["[MSD Manual Professional, « Tension Pneumothorax », consulté le 24.11.2026]"]}],"p":"CTH/J93.0__F1_18-E13","audite":true},{"id":"P001-isolee_Q10","progressive":false,"questions":[{"format":"A","situation":"starting_point","diagnosticMasque":true,"stem":"Un étudiant demande pourquoi un pneumothorax sous tension fait chuter la pression artérielle.","prompt":"Quelle explication est juste ?","options":[{"key":"A","text":"La pression intrathoracique comprime les veines caves et réduit le remplissage du cœur","correct":true,"why":"Choc obstructif."},{"key":"B","text":"Le poumon saigne","correct":false,"why":"Faux."},{"key":"C","text":"Une vasoplégie septique","correct":false,"why":"Faux."},{"key":"D","text":"Une bradycardie vagale","correct":false,"why":"Faux."},{"key":"E","text":"Une défaillance du ventricule gauche primitive","correct":false,"why":"Faux."}],"statements":[],"notions":["N04","N01"],"angle":"direct","difficulte":1,"ladder":{"zeroD":"Physiologie.","mechanism":"Retour veineux.","semiology":"Hypotension.","discriminant":"Obstruction.","decision":"Choc obstructif.","trap":"Choc cardiogénique.","anchor":"Tension = obstruction."},"sources":["[MSD Manual Professional, « Tension Pneumothorax », consulté le 24.11.2026]"]}],"p":"CTH/J93.0__F1_18-E13","audite":true},{"id":"P001-isolee_Q11","progressive":false,"questions":[{"format":"A","situation":"monographique","diagnosticMasque":false,"stem":"Cinq jours après le drainage d'un pneumothorax suffocant spontané, le drain bulle encore à chaque expiration chez un homme de 31 ans.","prompt":"Que proposez-vous ?","options":[{"key":"A","text":"Un avis de chirurgie thoracique pour fuite persistante","correct":true,"why":"Vidéothoracoscopie."},{"key":"B","text":"Retirer le drain","correct":false,"why":"Récidive."},{"key":"C","text":"Clamper le drain","correct":false,"why":"Danger."},{"key":"D","text":"Attendre 3 semaines","correct":false,"why":"Trop long."},{"key":"E","text":"Donner un antibiotique","correct":false,"why":"Faux."}],"statements":[],"notions":["N20","N21"],"angle":"application","difficulte":2,"ladder":{"zeroD":"Fuite.","mechanism":"Brèche persistante.","semiology":"5 jours.","discriminant":"Échec du drain.","decision":"Chirurgie.","trap":"Clamper.","anchor":"Fuite qui dure = chirurgien."},"sources":["[BTS Guideline for pleural disease, Roberts et al., Thorax 2023]"]}],"p":"CTH/J93.0__F1_18-E13","audite":true},{"id":"P001-isolee_Q12","progressive":false,"questions":[{"format":"A","situation":"monographique","diagnosticMasque":false,"stem":"Un homme de 27 ans, fumeur, quitte l'hôpital après un pneumothorax suffocant spontané drainé. Il veut prendre l'avion dans 3 jours et reprendre la plongée.","prompt":"Que lui conseillez-vous ?","options":[{"key":"A","text":"Éviter l'avion jusqu'à la résolution radiologique confirmée, renoncer à la plongée et arrêter de fumer","correct":true,"why":"Récidive."},{"key":"B","text":"Voler et plonger librement","correct":false,"why":"Faux."},{"key":"C","text":"Plonger mais ne pas voler","correct":false,"why":"Faux."},{"key":"D","text":"Voler avec un drain","correct":false,"why":"Faux."},{"key":"E","text":"Seulement réduire le tabac","correct":false,"why":"Insuffisant."}],"statements":[],"notions":["N24","N22","N23"],"angle":"application","difficulte":2,"ladder":{"zeroD":"Sortie.","mech