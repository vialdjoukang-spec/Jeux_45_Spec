","semiology":"Chute.","discriminant":"Pas de densitométrie.","decision":"Évaluer.","trap":"Rien.","anchor":"Fracture de fragilité = bilan."},"sources":["Avis d'expert, traumatologie thoracique (à vérifier)"]}],"p":"CTH/S22.3__S2_12-E04","audite":false},{"id":"P002-isolee_Q15","progressive":false,"questions":[{"format":"Kprim","situation":"monographique","diagnosticMasque":false,"stem":"Vous révisez la fracture de côte.","prompt":"Ces affirmations sont-elles vraies ou fausses ?","options":[],"statements":[{"text":"Elle est la lésion la plus fréquente du traumatisme thoracique fermé.","true":true,"why":"Expert."},{"text":"La douleur limite la toux et favorise l'atélectasie.","true":true,"why":"Expert."},{"text":"Le volet suppose des côtes fracturées en deux endroits.","true":true,"why":"Expert."},{"text":"La radiographie voit toutes les fractures non déplacées.","true":false,"why":"Faux."}],"notions":["N02","N03","N01","N11","N06"],"angle":"direct","difficulte":2,"ladder":{"zeroD":"Bases.","mechanism":"Mécanisme.","semiology":"Fréquence.","discriminant":"Volet.","decision":"Comprendre.","trap":"Radiographie parfaite.","anchor":"Clinique d'abord."},"sources":["Avis d'expert, traumatologie thoracique (à vérifier)"]}],"p":"CTH/S22.3__S2_12-E04","audite":false},{"id":"P002-isolee_Q16","progressive":false,"questions":[{"format":"Kprim","situation":"monographique","diagnosticMasque":false,"stem":"Vous cherchez les lésions associées à une fracture de côte.","prompt":"Ces affirmations sont-elles vraies ou fausses ?","options":[],"statements":[{"text":"Les côtes 9 à 12 font chercher une lésion splénique ou hépatique.","true":true,"why":"Expert."},{"text":"La 1re côte signe une haute énergie.","true":true,"why":"Expert."},{"text":"Un emphysème sous-cutané fait chercher un pneumothorax.","true":true,"why":"Expert."},{"text":"Un grill costal est indispensable dans une fracture simple.","true":false,"why":"Faux."}],"notions":["N08","N09","N07","N12","N13"],"angle":"direct","diffi