icule."},{"key":"E","text":"Luxation acromio-claviculaire","correct":false,"why":"Touche de piano."},{"key":"F","text":"Tendinopathie calcifiante","correct":false,"why":"Pas de blocage."},{"key":"G","text":"Rupture de coiffe isolée","correct":false,"why":"Pas de blocage."},{"key":"H","text":"Contusion du deltoïde","correct":false,"why":"Pas de blocage."},{"key":"I","text":"Arthrite septique","correct":false,"why":"Fièvre."},{"key":"J","text":"Névralgie amyotrophiante","correct":false,"why":"Pas de blocage mécanique."},{"key":"K","text":"Radiculopathie C5","correct":false,"why":"Cervicale."},{"key":"L","text":"Pseudopolyarthrite rhizomélique","correct":false,"why":"Bilatérale."}],"statements":[],"notions":["N03","N05","N13","N02"],"angle":"application","difficulte":2,"ladder":{"zeroD":"Épaule après crise.","mechanism":"Contraction.","semiology":"RE nulle.","discriminant":"Face trompeuse.","decision":"Postérieure.","trap":"Contusion.","anchor":"Crise + RE nulle."},"sources":["[Radiopaedia, « Posterior shoulder dislocation », consulté le 24.11.2026]"]}],"p":"ORT/S43.0__O4_1-E14","audite":false},{"id":"P001-isolee_Q20","progressive":false,"questions":[{"format":"MenuLong","situation":"monographique","diagnosticMasque":false,"stem":"Vous analysez la radiographie de face d'une épaule suspecte de luxation postérieure.","prompt":"Quels signes la soutiennent ? (3 réponses)","options":[{"key":"A","text":"Tête en ampoule électrique","correct":true,"why":"Rotation interne fixée."},{"key":"B","text":"Interligne gléno-huméral > 6 mm","correct":true,"why":"Rim sign."},{"key":"C","text":"Ligne d'impaction verticale (trough line)","correct":true,"why":"Encoche."},{"key":"D","text":"Tête sous la coracoïde","correct":false,"why":"Antérieure."},{"key":"E","text":"Encoche postéro-latérale de Hill-Sachs","correct":false,"why":"Antérieure."},{"key":"F","text":"Fracture de Bankart osseuse","correct":false,"why":"Antérieure."},{"key":"G","text":"Pincement de l'interligne","correct":false,"w