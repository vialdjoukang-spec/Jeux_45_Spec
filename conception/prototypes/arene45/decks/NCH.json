,"difficulte":3,"ladder":{"zeroD":"Après geste rachidien.","mechanism":"Saignement épidural.","semiology":"Anticoagulée.","discriminant":"Déficit bilatéral.","decision":"IRM et antagonisation.","trap":"Douleur banale.","anchor":"Anticoagulant + geste = hématome."},"sources":["Avis d'expert (à vérifier)"]}],"p":"NCH/G83.4__G10-E20","audite":false},{"id":"P001-isolee_Q08","progressive":false,"questions":[{"format":"A","situation":"starting_point","diagnosticMasque":true,"stem":"Un homme de 34 ans, qui s'injecte de l'héroïne, a 39 °C, une douleur lombaire intense et, depuis ce matin, une hypoesthésie périnéale.","prompt":"Quelle prise en charge proposez-vous ?","options":[{"key":"A","text":"Hémocultures, IRM avec gadolinium en urgence, puis drainage chirurgical et antibiothérapie","correct":true,"why":"Abcès épidural."},{"key":"B","text":"Antibiothérapie orale et contrôle à une semaine","correct":false,"why":"Retard."},{"key":"C","text":"Une ponction lombaire d'emblée","correct":false,"why":"Risque."},{"key":"D","text":"Des AINS","correct":false,"why":"Faux."},{"key":"E","text":"Un sevrage seul","correct":false,"why":"Faux."}],"statements":[],"notions":["N20","N15","N03"],"angle":"application","difficulte":3,"ladder":{"zeroD":"Fièvre et dos.","mechanism":"Infection épidurale.","semiology":"Injection.","discriminant":"Déficit sacré.","decision":"IRM gadolinium.","trap":"Ponction lombaire.","anchor":"Fièvre + selle = abcès."},"sources":["Avis d'expert (à vérifier)"]}],"p":"NCH/G83.4__G10-E20","audite":false},{"id":"P001-isolee_Q09","progressive":false,"questions":[{"format":"A","situation":"starting_point","diagnosticMasque":true,"stem":"Un homme de 66 ans porteur d'un stimulateur cardiaque non compatible avec l'IRM présente une anesthésie en selle et une rétention depuis 6 heures.","prompt":"Quel examen demandez-vous ?","options":[{"key":"A","text":"Un CT lombaire, au mieux une myélo-CT, en urgence","correct":true,"why":"Alternative."},{"key":"B","text":"Rien avant que 